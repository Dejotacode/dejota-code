name = "dejotacode-business-os-api"
main = "src/worker.ts"
compatibility_date = "2026-09-01"

[[d1_databases]]
binding = "DB"
database_name = "dejotacode_os"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "src/db/migrations"

[vars]
APP_ENV = "development"
SESSION_TTL_SECONDS = "604800"
APP_URL = "https://SEU-DOMINIO.com"

# Etapa 5.32 — Media Library (Cloudflare R2)
# Configure a real bucket name before deploy.
[[r2_buckets]]
binding = "MEDIA"
bucket_name = "dejotacode-media"
