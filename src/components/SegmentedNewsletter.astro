---
export interface Props {
  segment?: string;
  compact?: boolean;
}

const { segment = 'geral', compact = false } = Astro.props;
const apiBase = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/$/, '');
const endpoint = apiBase ? `${apiBase}/api/newsletter/subscribe-interest` : '/api/newsletter/subscribe-interest';
const source = Astro.url.pathname;
---
<section class:list={["segmented-newsletter", "card", { compact }]} data-newsletter-segment={segment}>
  <div>
    <span class="eyebrow">Newsletter Dejotacode</span>
    <h2>{segment === 'Renda Digital' ? 'Receba o próximo passo para sua renda digital.' : segment === 'Programação' ? 'Construa projetos melhores toda semana.' : segment === 'IA' ? 'Use IA com mais clareza e menos complicação.' : 'Aprenda, construa e avance toda semana.'}</h2>
    <p class="muted">Conteúdo prático, novos tutoriais e materiais gratuitos. Sem spam e com cancelamento fácil.</p>
  </div>
  <form class="segmented-form" data-segmented-form data-endpoint={endpoint} data-source={source} novalidate>
    <label class="sr-only" for={`seg-name-${segment}`}>Seu nome</label>
    <input id={`seg-name-${segment}`} name="name" type="text" autocomplete="name" placeholder="Seu nome" required />
    <label class="sr-only" for={`seg-email-${segment}`}>Seu e-mail</label>
    <input id={`seg-email-${segment}`} name="email" type="email" autocomplete="email" placeholder="voce@exemplo.com" required />
    <input type="hidden" name="segment" value={segment} />
    <input type="hidden" name="source" value={source} />
    <label class="consent compact-consent">
      <input name="consent" type="checkbox" required />
      <span>Aceito receber conteúdo e posso cancelar quando quiser.</span>
    </label>
    <button class="btn btn-primary" type="submit" data-event="newsletter_submit">Quero receber →</button>
    <p class="form-status" data-form-status role="status" aria-live="polite"></p>
  </form>
</section>

<script src="../scripts/forms.ts"></script>
