---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteSeo } from '../data/seo';
import '../styles/global.css';
import SearchConsoleVerification from '../components/SearchConsoleVerification.astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = `${siteSeo.name} — Aqui transformo conhecimento em renda.`,
  description = siteSeo.description,
  canonical,
  ogType = 'website',
  ogImage,
  noindex = false
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const image = ogImage ? new URL(ogImage, Astro.site ?? Astro.url.origin).href : undefined;
const siteUrl = Astro.site?.href ?? siteSeo.url;
const robots = noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

// Schemas Estruturados (Schema.org JSON-LD)
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteSeo.name,
  url: siteUrl,
  description,
  inLanguage: siteSeo.language,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl.replace(/\/$/, '')}/buscar/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteSeo.name,
  url: siteUrl,
  logo: `${siteUrl.replace(/\/$/, '')}/icon.svg`,
  sameAs: [
    'https://instagram.com/dejotacode',
    'https://youtube.com/@dejotacode',
    'https://www.linkedin.com/company/dejotacode',
    'https://github.com/dejotacode'
  ]
};
---
<!doctype html>
<html lang={siteSeo.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content={siteSeo.author} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#2563EB" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <SearchConsoleVerification />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Dejotacode RSS" href="/rss.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    
    <!-- Fontes pré-conectadas com display swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Poppins:wght@600;700;800&display=swap" />

    <!-- Open Graph & Social Cards -->
    <meta property="og:site_name" content={siteSeo.name} />
    <meta property="og:locale" content={siteSeo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo"><slot /></main>
    <Footer />

    <!-- Schemas JSON-LD Estruturados -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>

    <!-- Módulo Client-Side de Telemetria e Otimizações -->
    <script src="../scripts/tracking.ts"></script>
  </body>
</html>
