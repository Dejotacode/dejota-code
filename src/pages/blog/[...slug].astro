---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';
import SegmentedNewsletter from '../../components/SegmentedNewsletter.astro';
import ConversionBox from '../../components/ConversionBox.astro';
import FAQ from '../../components/FAQ.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ClusterNav from '../../components/ClusterNav.astro';
import AuthorExpertise from '../../components/AuthorExpertise.astro';
import { getPublishedPosts, getPublishedPostBySlug, postUrl } from '../../lib/editorial';
export async function getStaticPaths(){ const posts=await getPublishedPosts(); return posts.map(post=>({params:{slug:`${post.categorySlug}/${post.slug}`},props:{post}})); }
const post=Astro.props.post ?? await getPublishedPostBySlug(String(Astro.params.slug).split('/').pop()!);
if(!post) throw new Error('Post não encontrado');
const allPosts=await getPublishedPosts();
const related=allPosts.filter(candidate=>candidate.id!==post.id && (candidate.clusterSlug===post.clusterSlug || candidate.categorySlug===post.categorySlug || candidate.tags.some(tag=>post.tags.includes(tag)))).sort((a,b)=>Number(b.clusterSlug===post.clusterSlug)-Number(a.clusterSlug===post.clusterSlug)||b.publishedAt.valueOf()-a.publishedAt.valueOf()).slice(0,3);
const ordered=[...allPosts].sort((a,b)=>b.publishedAt.valueOf()-a.publishedAt.valueOf()); const currentIndex=ordered.findIndex(x=>x.id===post.id); const newer=currentIndex>0?ordered[currentIndex-1]:undefined; const older=currentIndex>=0&&currentIndex<ordered.length-1?ordered[currentIndex+1]:undefined;
const canonical=new URL(postUrl(post),Astro.site??Astro.url.origin).href; const formattedDate=post.publishedAt.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'}); const updated=post.updatedAt?.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'});
const faq=[{question:`O que vou aprender em “${post.title}”?`,answer:post.description},{question:'Este conteúdo é indicado para iniciantes?',answer:'Sim. O Dejotacode prioriza explicações práticas e progressivas, com linguagem simples e exemplos aplicáveis.'}];
const articleSchema={'@context':'https://schema.org','@type':'Article',headline:post.title,description:post.description,datePublished:post.publishedAt.toISOString(),...(post.updatedAt?{dateModified:post.updatedAt.toISOString()}:{}),author:{'@type':'Person',name:post.author,url:new URL('/sobre/autor/',Astro.site??Astro.url.origin).href},publisher:{'@type':'Organization',name:'Dejotacode',url:Astro.site?.href??Astro.url.origin},mainEntityOfPage:{'@type':'WebPage','@id':canonical},...(post.image?{image:new URL(post.image,Astro.site??Astro.url.origin).href}:{}),articleSection:post.category,keywords:post.tags.join(', ')};
const breadcrumbSchema={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Início',item:new URL('/',Astro.site??Astro.url.origin).href},{ '@type':'ListItem',position:2,name:'Blog',item:new URL('/blog/',Astro.site??Astro.url.origin).href},{ '@type':'ListItem',position:3,name:post.category,item:new URL(`/${post.categorySlug}/`,Astro.site??Astro.url.origin).href},{ '@type':'ListItem',position:4,name:post.title,item:canonical}]};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))};
---
<BaseLayout title={post.seoTitle||`${post.title} — Dejotacode`} description={post.seoDescription||post.description} canonical={post.canonicalUrl||canonical} ogType="article" ogImage={post.ogImage||post.image}>
<ReadingProgress/><article class="article-page" data-article><div class="container article-container">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Início</a><span>›</span><a href="/blog/">Blog</a><span>›</span><a href={`/${post.categorySlug}/`}>{post.category}</a></nav>
<header class="article-header"><span class="tag">{post.category}</span><h1>{post.title}</h1><p class="lead">{post.description}</p><div class="article-meta"><span>Por <strong>{post.author}</strong></span><span>•</span><time datetime={post.publishedAt.toISOString()}>{formattedDate}</time><span>•</span><span>{post.readingTime} min de leitura</span>{updated&&<><span>•</span><span>Atualizado em {updated}</span></>}</div>{(post.updatedAt||post.reviewedAt)&&<div class="article-freshness" aria-label="Atualização editorial">{post.updatedAt&&<span><strong>Atualizado:</strong> {updated}</span>}{post.reviewedAt&&<span><strong>Revisado:</strong> {post.reviewedAt.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'})}</span>}</div>}{post.tags.length>0&&<div class="tags">{post.tags.map(tag=><a class="tag tag-muted" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>}</header>
<div class="article-layout"><aside class="article-sidebar"></aside><div class="article-main"><div class="prose" set:html={post.contentHtml}></div><FAQ items={faq}/><AuthorExpertise name={post.author} reviewedBy={post.reviewedBy} reviewedAt={post.reviewedAt} experienceNote={post.experienceNote}/>{post.sources.length>0&&<section class="source-list" aria-label="Fontes e referências"><h2>Fontes e referências</h2><ul>{post.sources.map(source=><li><a href={source} rel="nofollow noopener" target="_blank">{source}</a></li>)}</ul></section>}<NewsletterCTA/><SegmentedNewsletter segment={post.categorySlug}/><ConversionBox title="Pronto para o próximo passo?" description="Continue pela trilha da categoria e aplique o que acabou de aprender." href={`/${post.categorySlug}/`} label="Continuar →"/><ClusterNav clusterSlug={post.clusterSlug} currentId={post.id}/></div></div></div></article>
{(newer||older)&&<nav class="section post-navigation" aria-label="Navegação entre artigos"><div class="container post-nav-grid">{older?<a class="post-nav-card card" href={postUrl(older)}><span>← Anterior</span><strong>{older.title}</strong></a>:<span></span>}{newer?<a class="post-nav-card card align-right" href={postUrl(newer)}><span>Próximo →</span><strong>{newer.title}</strong></a>:<span></span>}</div></nav>}
{related.length>0&&<section class="section related"><div class="container"><span class="eyebrow">Continue aprendendo</span><h2>Artigos relacionados</h2><div class="grid grid-3">{related.map(candidate=><PostCard post={candidate}/>)}</div></div></section>}
<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</BaseLayout>
