---
import { getPublishedPosts } from '../lib/editorial';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = (await getPublishedPosts()).sort((a,b) => b.publishedAt.valueOf()-a.publishedAt.valueOf());
const featured = posts.filter(p => p.featured).slice(0,3);
const recent = posts.filter(p => !p.featured).slice(0,6);
---
<BaseLayout>
  <section class="hero"><div class="container hero-grid"><div><span class="eyebrow">Aprenda. Construa. Monetize.</span><h1>Transforme conhecimento em <span>renda.</span></h1><p class="lead">Tutoriais simples, tecnologia e estratégias práticas para você aprender, construir seus projetos e começar sua jornada digital.</p><div class="actions"><a class="btn btn-primary" href="/comece-aqui/">Começar agora →</a><a class="btn btn-secondary" href="/blog/">Ver tutoriais</a></div></div><div class="hero-card"><div class="terminal"><div>dejo@code:~$ <span>start</span></div><div>→ aprender</div><div>→ construir</div><div>→ publicar</div><div>→ monetizar</div><div class="cursor">_</div></div></div></div></section>
  <section class="proof-strip" aria-label="O que você encontra no Dejotacode"><div class="container proof-grid"><div><strong>4</strong><span>trilhas para explorar</span></div><div><strong>4</strong><span>artigos publicados</span></div><div><strong>1</strong><span>método do zero à prática</span></div><div><strong>∞</strong><span>próximos projetos</span></div></div></section>
  <section class="section"><div class="container"><span class="eyebrow">Explore</span><h2>Aprenda no seu ritmo</h2><div class="grid grid-4 category-grid"><a class="category-card category-programming" href="/programacao/"><span class="category-icon" aria-hidden="true">&lt;/&gt;</span><b>Programação</b><p class="muted">Web, código e projetos.</p></a><a class="category-card category-security" href="/linux-seguranca/"><span class="category-icon" aria-hidden="true">01</span><b>Linux & Segurança</b><p class="muted">Terminal, sistemas e segurança.</p></a><a class="category-card category-income" href="/renda-digital/"><span class="category-icon" aria-hidden="true">↗</span><b>Renda Digital</b><p class="muted">Freelancing, afiliados e negócios.</p></a><a class="category-card category-ai" href="/ia/"><span class="category-icon" aria-hidden="true">✦</span><b>IA</b><p class="muted">Ferramentas e aplicações práticas.</p></a></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Conteúdo em destaque</span><h2>Comece por aqui</h2></div><a class="btn btn-secondary" href="/blog/">Ver todos →</a></div><div class="grid grid-3">{featured.map((post) => <PostCard post={post} />)}</div></div></section>
  <section class="section journey"><div class="container"><span class="eyebrow">Método Dejotacode</span><h2>Do zero à prática.</h2><div class="grid grid-4"><div><strong>01. Aprenda</strong><p class="muted">Entenda sem complicação.</p></div><div><strong>02. Construa</strong><p class="muted">Faça algo real.</p></div><div><strong>03. Publique</strong><p class="muted">Mostre seu trabalho.</p></div><div><strong>04. Monetize</strong><p class="muted">Transforme habilidade em oportunidade.</p></div></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Novidades</span><h2>Artigos recentes</h2></div><a class="btn btn-secondary" href="/blog/">Explorar blog →</a></div><div class="grid grid-3">{recent.map((post) => <PostCard post={post} />)}</div></div></section>
  <section class="section"><div class="container"><div class="lead-box"><div><span class="eyebrow">Material gratuito</span><h2>Comece sua jornada digital</h2><p>Receba conteúdos práticos e descubra os próximos passos.</p></div><a class="btn btn-primary" href="/newsletter/">Quero começar →</a></div></div></section>
</BaseLayout>
<style>.hero{padding:96px 0;background:radial-gradient(circle at 85% 20%,rgba(37,99,235,.15),transparent 35%),var(--bg)}.hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:center}.hero h1{max-width:760px}.hero h1 span{color:var(--primary)}.lead{font-size:1.15rem;color:var(--muted);max-width:680px}.actions{display:flex;gap:12px;margin-top:28px}.hero-card{background:linear-gradient(145deg,#111827,#1e293b);border-radius:24px;padding:26px;box-shadow:var(--shadow);transform:rotate(1deg)}.terminal{color:#dbeafe;font-family:'JetBrains Mono',monospace;line-height:2;font-size:1rem}.terminal span{color:#34d399}.cursor{color:#60a5fa}.proof-strip{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--surface)}.proof-grid{display:grid;grid-template-columns:repeat(4,1fr);padding:26px 0}.proof-grid div{display:grid;gap:2px;padding:0 24px;border-left:1px solid var(--border)}.proof-grid div:first-child{padding-left:0;border-left:0}.proof-grid strong{font-family:Poppins,sans-serif;font-size:1.7rem;line-height:1;color:var(--primary)}.proof-grid span{color:var(--muted);font-size:.85rem}.journey{background:var(--surface)}.lead-box{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:40px;border:1px solid var(--border);border-radius:24px;background:var(--surface);box-shadow:var(--shadow)}@media(max-width:800px){.hero{padding:64px 0}.hero-grid{grid-template-columns:1fr}.hero-card{transform:none}.lead-box{display:grid}.actions{flex-wrap:wrap}.proof-grid{grid-template-columns:repeat(2,1fr);gap:20px}.proof-grid div:nth-child(3){padding-left:0;border-left:0}}@media(max-width:480px){.proof-grid{grid-template-columns:1fr}.proof-grid div,.proof-grid div:nth-child(n){padding:0;border-left:0}}
  .category-grid { margin-top: 24px; }
  .category-card { display: block; position: relative; min-height: 184px; padding: 24px 8px 22px; border-bottom: 2px solid color-mix(in srgb, var(--category-color) 35%, var(--border)); transition: transform .2s, border-color .2s; }
  .category-card:hover { transform: translateY(-5px); border-color: var(--category-color); }
  .category-icon { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 26px; border-radius: 12px; background: color-mix(in srgb, var(--category-color) 14%, transparent); color: var(--category-color); font-family: 'JetBrains Mono', monospace; font-size: 1.05rem; font-weight: 800; }
  .category-card b { font-family: Poppins, sans-serif; font-size: 1.05rem; }
  .category-card p { margin-bottom: 0; }
  .category-programming { --category-color: var(--programming); }
  .category-security { --category-color: var(--security); }
  .category-income { --category-color: var(--income); }
  .category-ai { --category-color: var(--ai); }
</style>
